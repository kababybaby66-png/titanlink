# TitanLink Environment Configuration
# ======================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Relay / Signaling Server ───────────────────────────────────────────────
# IP address of your relay server (used by the renderer via Vite VITE_ prefix)
VITE_RELAY_IP=YOUR_RELAY_IP_HERE
VITE_RELAY_PORT=5000
VITE_SIGNALING_URL=http://YOUR_RELAY_IP_HERE:3001

# ─── TURN Server (coturn) ───────────────────────────────────────────────────
# Single server:
#   TURN_SERVER_URL=turn:your-ip:3478
#   TURN_SERVER_SECRET=your-secret
#
# Multiple servers (comma-separated, first is primary):
#   TURN_SERVER_URL=turn:primary-ip:3478,turn:backup-ip:3478
#   TURN_SERVER_SECRET=shared-secret        (or comma-separated per-server secrets)
#
# If not set, falls back to free public TURN servers (limited bandwidth).
TURN_SERVER_URL=
TURN_SERVER_SECRET=

# ─── Optional: ExpressTurn Fallback Credentials ─────────────────────────────
# Get your own free credentials at: https://www.expressturn.com/
# EXPRESSTURN_USERNAME=your-username
# EXPRESSTURN_CREDENTIAL=your-credential
